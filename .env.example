FLASK_APP=app.py
FLASK_ENV=production

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key

# REQUIRED: PostgreSQL connection string (SQLite is NOT supported in production)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/ai_interview_coach

# PostgreSQL credentials (used by docker-compose)
POSTGRES_DB=ai_interview_coach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password

# Redis (used for rate limiting; falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379/0

# Optional: AI/ML API keys
AI_API_KEY=replace-with-your-ai-api-key

# Optional: Mail configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Optional: Upload limits (default 16 MB)
MAX_CONTENT_LENGTH=16777216
WTF_CSRF_ENABLED=True
